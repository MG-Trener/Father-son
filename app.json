{
  "expo": {
    "name": "Папа & Я",
    "slug": "papa-i-ya",
    "version": "0.5.2",
    "orientation": "portrait",
    "scheme": "papaiya",
    "userInterfaceStyle": "light",
    "primaryColor": "#0A3143",
    "icon": "./assets/generated/app-icon.png",
    "android": {
      "package": "com.mgtrener.fatherson",
      "versionCode": 19,
      "icon": "./assets/generated/app-icon.png",
      "permissions": [
        "android.permission.REQUEST_INSTALL_PACKAGES"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/generated/app-icon.png",
        "monochromeImage": "./assets/generated/app-icon-monochrome.png",
        "backgroundColor": "#0A3143"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#071F2A",
          "image": "./assets/generated/splash-screen.png",
          "imageWidth": 360,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-notifications",
        {
          "defaultChannel": "connection"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Разрешить приложению «Папа & Я» записывать голосовые истории.",
          "recordAudioAndroid": true,
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      "expo-asset",
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
