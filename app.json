{
  "expo": {
    "name": "Папа & Я",
    "slug": "papa-i-ya",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "papaiya",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.mgtrener.fatherson",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#F4F1E8"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "defaultChannel": "connection"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Разрешить приложению «Папа & Я» записывать голосовые истории.",
          "recordAudioAndroid": true,
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
